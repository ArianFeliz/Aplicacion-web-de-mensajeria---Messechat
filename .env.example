# Copia este archivo como ".env" y completa con tus datos reales.

# Cadena de conexión de tu base de datos Neon (Postgres).
# La consigues en tu dashboard de Neon -> Connection string.
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.neon.tech/messechat?sslmode=require

# Clave secreta para sesiones de Flask (pon cualquier texto largo y aleatorio).
SECRET_KEY=cambia-esto-por-algo-seguro
